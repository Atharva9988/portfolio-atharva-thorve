# ==============================================================================
# Environment Configuration Template (Example)
# Copy this file to .env and fill in your values
# ==============================================================================

# Contact Form Service (Web3Forms or Formspree)
# Get a free access key at https://web3forms.com/ or https://formspree.io/
CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Owner & Site Configuration
SITE_OWNER_NAME="Atharva Thorve"
SITE_OWNER_EMAIL=your_email@example.com
SITE_URL=https://atharva9988.github.io/portfolio-atharva-thorve/

# Local Development Server Port
PORT=8000

# Backend / Project API Keys (for local testing of backend projects)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
